<script defer>
document.addEventListener('DOMContentLoaded', () => {
  const typedEl = document.querySelector('.typed-words');
  if (typedEl) {
    new Typed(typedEl, {
      strings: [" Business Automation Systems", " Mobile Applications", " Web Applications"],
      typeSpeed: 80,
      backSpeed: 80,
      backDelay: 4000,
      startDelay: 1000,
      loop: true
    });
  }

  if (typeof lozad === "function") {
    const observer = lozad();
    observer.observe();
  }
});
</script>


